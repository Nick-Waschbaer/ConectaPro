# Copia este archivo como .env y ajusta la URL. No pongas secretos aquí:
# las variables VITE_* quedan visibles en el navegador.
# Debe terminar en /api (en la demo, la URL de ngrok + /api).
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Modo de demostración local (solo para probar la interfaz sin backend).
# Con "true" se usan profesionales ficticios y las solicitudes NO se guardan ni se envían.
# Déjalo en false (o bórralo) para usar la API real.
VITE_USE_MOCK_API=false
